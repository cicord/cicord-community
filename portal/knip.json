{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // index.html → src/main.tsx is detected by the Vite plugin; tests by the Vitest plugin.
  "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
  // src/cicord-routes.d.ts is generated by `cicord portal typegen` (module augmentation).
  "ignore": ["src/cicord-routes.d.ts"],
  // `vite` is an alias to @voidzero-dev/vite-plus-core that vite-plus requires as a peer: it
  // is never imported directly.
  "ignoreDependencies": ["vite"]
}
